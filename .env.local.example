# ============================================================
# LinkUp Golf — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-side only. Bypasses RLS.

# ------------------------------------------------------------
# Go High Level (GHL)
# Settings → Integrations → Private Integrations → API Key
# Location ID: Settings → Business Profile → Location ID
# ------------------------------------------------------------
GHL_API_KEY=your-ghl-private-integration-api-key
GHL_LOCATION_ID=your-ghl-location-id

# Agency ID, used only to provision a GHL user when a host is approved (the
# account that then staffs their venue's calendar). Creating a user is an agency
# action, so a location-scoped token can't do it — leave this unset and host
# approval still works, it just logs that the GHL user was skipped and the
# calendar falls back to the default assignee.
# GHL → Settings → Company / Agency → copy the company ID.
GHL_COMPANY_ID=your-ghl-agency-company-id

# Aviara golf calendar ID used for tee time slot queries and booking creation.
# GHL → Calendars → select the Aviara calendar → copy ID from URL or settings.
GHL_AVIARA_CALENDAR_ID=your-aviara-calendar-id

# GHL user ID assigned to the Aviara calendar resource (passed as userId in free-slots queries).
# GHL → Calendars → Aviara calendar → Team Members → copy user ID.
GHL_AVIARA_CALENDAR_USER_ID=your-aviara-calendar-user-id

# ------------------------------------------------------------
# Email notifications (Resend)
#
# The second channel beside web push — see src/lib/notify.ts for which
# notifications go out by email and which stay push-only. Leave RESEND_API_KEY
# unset and the channel is simply off: nothing is sent, nothing fails, and push
# carries on as before. That's the intended state for local work and previews.
# ------------------------------------------------------------
# resend.com → API Keys. Needs "Sending access".
RESEND_API_KEY=re_your_resend_api_key

# Must be an address on a domain verified in Resend → Domains. An unverified
# sender is accepted by the API and then junked, which looks like working.
EMAIL_FROM=LinkUp Golf <notifications@linkup.golf>

# Where a member's reply goes. Optional — omitted, replies go to EMAIL_FROM.
EMAIL_REPLY_TO=hello@linkup.golf

# Resend → Webhooks → the endpoint's Signing Secret (whsec_…). Point the
# endpoint at <app>/api/webhooks/resend and subscribe it to at least
# email.bounced and email.complained.
#
# Without this, nothing ever learns that an address is dead or that a member
# reported us as spam, and every later broadcast mails them again — which is
# precisely what drives a sending domain into the spam folder. Unset means every
# delivery is rejected, so the channel still sends; it just never learns.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Signs the one-click unsubscribe link in every email (RFC 8058, and required
# of bulk senders by Gmail and Yahoo). Optional: with it unset the
# service-role key is used instead, so the link works out of the box. Setting
# or rotating it invalidates the links in mail already sent, which is why it
# isn't the default.
EMAIL_UNSUBSCRIBE_SECRET=

# Webhook secret — must match the value set in GHL webhook config.
GHL_WEBHOOK_SECRET=your-webhook-secret

# Booking status webhook secret — set as x-linkup-secret header in GHL workflow HTTP actions.
GHL_BOOKING_WEBHOOK_SECRET=your-booking-webhook-secret-min-32-chars

# Avi-Play pipeline. The app doesn't create opportunities: GHL's own pipeline
# automation does, from the appointment. The pipeline and tentative-stage ids
# are not read by any code. The cancelled stage is read, but only takes effect
# when a booking row holds ghl_opportunity_id, which nothing writes, so in
# practice it does nothing. See docs/HANDOVER.md section 3.1.
GHL_AVI_PLAY_PIPELINE_ID=your-avi-play-pipeline-id
GHL_AVI_PLAY_TENTATIVE_STAGE_ID=your-avi-play-tentative-stage-id    # "Tentative" stage
GHL_AVI_PLAY_CANCELLED_STAGE_ID=your-avi-play-cancelled-stage-id    # "Cancelled" stage (for app-initiated cancellations)

# ------------------------------------------------------------
# GHL Workflow IDs: NOT USED. They fill a GHL_WORKFLOWS map in
# src/lib/ghl/client.ts that nothing reads, so the app never starts these
# workflows. The sign-in email comes from Supabase. The two workflows the app
# does start (booking and payment reminders) are inbound-webhook paths in
# src/lib/constants.ts. Safe to leave blank. See docs/HANDOVER.md section 3.1.
# ------------------------------------------------------------
GHL_WORKFLOW_MAGIC_LINK=your-magic-link-workflow-id        # Sends the magic login link email
GHL_WORKFLOW_WELCOME=your-welcome-workflow-id              # Fires when a new member joins
GHL_WORKFLOW_REFERRAL=your-referral-invite-workflow-id     # Sends referral invitation to prospect
GHL_WORKFLOW_BOOKING_CONFIRM=your-booking-confirm-workflow-id  # Booking confirmation to member
GHL_WORKFLOW_FOCUS_2W=your-focus-linkup-2w-workflow-id    # Focus LinkUp reminder 2 weeks out
GHL_WORKFLOW_FOCUS_1W=your-focus-linkup-1w-workflow-id    # Focus LinkUp reminder 1 week out

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.linkup.golf   # No trailing slash. Used for magic link redirect URLs.

# ------------------------------------------------------------
# Push Notifications (VAPID)
# Generate a key pair ONCE and reuse across deployments.
# Changing keys invalidates all existing push subscriptions.
# Generate: npm run generate-vapid
# ------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key    # Safe to expose to browser
VAPID_PRIVATE_KEY=your-vapid-private-key              # Server-side only. Never expose.
VAPID_CONTACT_EMAIL=hello@linkup.golf                 # Contact email sent in VAPID header

# ------------------------------------------------------------
# Stripe — the cancellation policy (late-cancel fees, invoiced)
# Dashboard → Developers → API keys. Use a test key (sk_test_) locally.
# Unset means the policy is off: no fee is stated and cancelling costs nothing.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key                 # Server-side only. Never expose.

# Signing secret for POST /api/webhooks/stripe. Dashboard → Developers →
# Webhooks → add endpoint https://app.linkup.golf/api/webhooks/stripe with
# invoice.paid and invoice.voided (plus checkout.session.completed and
# payment_intent.succeeded, for fees from before invoicing). Locally:
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints one.
# Unset means every delivery is rejected — invoices still go out, but a paid
# one is never marked paid.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ------------------------------------------------------------
# Cron Jobs
# Must match the Authorization header sent by Vercel Cron.
# Use a cryptographically random string of 32+ characters.
# Generate: openssl rand -hex 32
# ------------------------------------------------------------
CRON_SECRET=your-random-cron-secret-min-32-chars

# ------------------------------------------------------------
# Development
# Set to false to disable MSW mock server and hit real APIs.
# Omit or set to true to enable mocking in development.
# ------------------------------------------------------------
NEXT_PUBLIC_MOCK=false

# ------------------------------------------------------------
# Optional
# ------------------------------------------------------------
# Shared cache across server instances (Upstash Redis REST). Unset = an
# in-memory cache per instance, which is fine for one instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Encrypts Vercel-toolbar feature-flag overrides. Unset = no overrides.
FLAGS_SECRET=

# false hides Focus LinkUps everywhere.
NEXT_PUBLIC_FEATURE_FOCUS_LINKUPS=true

# debug | info | warn | error
LOG_LEVEL=info
